# Application Configuration
PORT=3030
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://localhost:27017/nest-auth

# JWT Authentication Secrets and Expirations
JWT_ACCESS_SECRET=replace_with_strong_access_secret_key_in_production
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret_key_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security and Cryptography
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRES_IN_MINUTES=10

# Initial Super Admin Seed Credentials (required for running `npm run seed:admin`)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_to_a_secure_password_min_8_chars

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gmail SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="CareerLaunch <your_email@gmail.com>"
